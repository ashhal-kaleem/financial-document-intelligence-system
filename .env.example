# ─────────────────────────────────────────────
# Financial Document Intelligence System (FDIS) — Environment Config
# Copy this file to .env and fill in your values
# ─────────────────────────────────────────────

# ── LLM Backend ──────────────────────────────
# Options: "groq" | "mock"
LLM_BACKEND=groq

# Groq settings
GROQ_API_KEY=gsk_...
# Options: llama-3.1-8b-instant (fast) | llama-3.3-70b-versatile (quality)
GROQ_MODEL=llama-3.1-8b-instant

# ── Embedding Model ──────────────────────────
# Local sentence-transformers model name (no API key required)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ── Vector Store ─────────────────────────────
# Options: "faiss" | "supabase"
VECTOR_STORE=faiss
VECTOR_STORE_PATH=data/processed/vector_store

# Supabase — only needed when VECTOR_STORE=supabase
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_KEY=<service-role-or-anon-key>
# SUPABASE_TABLE=chunks
# SUPABASE_RPC=match_chunks

# ── Chunking ─────────────────────────────────
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# ── Retrieval ────────────────────────────────
RETRIEVAL_TOP_K=5
RETRIEVAL_SCORE_THRESHOLD=0.3

# Optional cross-encoder reranking
USE_RERANKER=false
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_CANDIDATES=20

# ── API ──────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true
CORS_ORIGINS=http://localhost:3000

# ── Logging ──────────────────────────────────
LOG_LEVEL=INFO
