# Copy to backend/.env (never commit the real file).

# Supabase (Project Settings > API)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=      # server only, never expose to the browser
SUPABASE_STORAGE_BUCKET=documents   # keep this bucket PRIVATE

# LLM
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
OPENROUTER_API_KEY=
OPENROUTER_DEFAULT_MODEL=liquid/lfm-2.5-2.6b:free

# Embeddings (Hugging Face Inference)
HF_TOKEN=

# Security
AUTH_REQUIRED=true              # false is honored only with DEBUG=true AND no hosting platform env (fails closed otherwise)
DEBUG=false
ALLOWED_ORIGINS=["http://localhost:3000"]   # JSON list; add your frontend URL in production
RATE_LIMIT_PER_MINUTE=30
