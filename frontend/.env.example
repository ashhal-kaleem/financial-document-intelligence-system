# Public browser config only. Configure these in the Vercel frontend project.
# Use your actual Render service origin, ending in /api/v1. Never use a guessed URL.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Never put service-role keys, provider keys or OAuth client secrets here.
